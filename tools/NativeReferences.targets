<Project>
  <Target Name="UseFreshNativeValheimReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(AwlNativeValheimReferences)\assembly_valheim.dll')" Text="Prepare fresh native game references before building." />
    <PropertyGroup><AssemblySearchPaths>{HintPathFromItem};$(AssemblySearchPaths)</AssemblySearchPaths></PropertyGroup>
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.HintPath)' != '' And !Exists('%(Reference.HintPath)')" />
      <Reference Remove="assembly_valheim;assembly_utils;assembly_guiutils;SoftReferenceableAssets" />
      <Reference Include="assembly_valheim"><HintPath>$(AwlNativeValheimReferences)\assembly_valheim.dll</HintPath><Private>false</Private></Reference>
      <Reference Include="assembly_utils"><HintPath>$(AwlNativeValheimReferences)\assembly_utils.dll</HintPath><Private>false</Private></Reference>
      <Reference Include="assembly_guiutils"><HintPath>$(AwlNativeValheimReferences)\assembly_guiutils.dll</HintPath><Private>false</Private></Reference>
      <Reference Include="SoftReferenceableAssets"><HintPath>$(AwlNativeValheimReferences)\SoftReferenceableAssets.dll</HintPath><Private>false</Private></Reference>
    </ItemGroup>
  </Target>
</Project>
